.#------------------------------------------------------------------------------
.expect|filter+xml
.# Content conversions
.#------------------------------------------------------------------------------
<wikiSpace name="MySpace">
  <wikiDocument name="WebHome">
    <wikiDocumentLocale>
      <p>
        <parameters>
          <entry>
            <string>creation_author</string>
            <string>XWiki.Teo</string>
          </entry>
          <entry>
            <string>creation_date</string>
            <date>2012-08-21 15:37:47.0 UTC</date>
          </entry>
          <entry>
            <string>lastrevision</string>
            <string>1</string>
          </entry>
        </parameters>
      </p>
      <wikiDocumentRevision revision="1">
        <p>
          <parameters>
            <entry>
              <string>revision_author</string>
              <string>XWiki.Teo</string>
            </entry>
            <entry>
              <string>revision_date</string>
              <date>2016-10-11 14:47:37.0 UTC</date>
            </entry>
            <entry>
              <string>revision_comment</string>
              <string></string>
            </entry>
            <entry>
              <string>title</string>
              <string>My Space</string>
            </entry>
            <entry>
              <string>content</string>
              <string>== {{id name="MySpaceHome-Align"/}}Align ==

(% align="left" class="confluence_align_content someClass" %)
(((
THis content is left

**Strong **//italic//

{{info title="Proof"}}
That this supports rich content
{{/info}}

\\
)))

(% align="right" class="confluence_align_content someClass" %)
(((
THis content is right

**Strong **//italic//

{{info title="Proof"}}
That this supports rich content
{{/info}}

\\
)))

(% align="center" class="confluence_align_content someClass" %)
(((
THis content is center

**Strong **//italic//

{{info title="Proof"}}
That this supports rich content
{{/info}}

\\
)))

(% class="confluence_align_content someClass" %)
(((
THis content is justified

**Strong **//italic//

{{info title="Proof"}}
That this supports rich content
{{/info}}

\\
)))

== {{id name="MySpaceHome-Div"/}}Div ==

(% style="color: grey" id="someId" dir="rtl" lang="ro" title="Some text shown on hover" class="confluence_div_content someClass" %)
(((
THis is some nice content of the div

**Strong **//italic//

{{info title="Proof"}}
That this supports rich content
{{/info}}

\\
)))

== {{id name="MySpaceHome-p"/}}p ==

(% style="opacity: 0.5" id="someId" dir="rtl" lang="ro" title="U are hovering this" class="confluence_p_content someClass" %)
(((
Some other rich content

**Strong **//italic//

{{info title="Proof"}}
That this supports rich content
{{/info}}

\\
)))</string>
            </entry>
            <entry>
              <string>syntax</string>
              <org.xwiki.rendering.syntax.Syntax>
                <type>
                  <name>XWiki</name>
                  <id>xwiki</id>
                  <variants class="empty-list"/>
                </type>
                <version>2.1</version>
              </org.xwiki.rendering.syntax.Syntax>
            </entry>
          </parameters>
        </p>
      </wikiDocumentRevision>
    </wikiDocumentLocale>
  </wikiDocument>
</wikiSpace>
.#------------------------------------------------------------------------------
.input|confluence+xml
.configuration.source=macrosToGroups
.configuration.storeConfluenceDetailsEnabled=false
.#------------------------------------------------------------------------------
